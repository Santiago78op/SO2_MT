    },
    {
      "id": "ihdC1djXMP_vjW2D3awhu",
      "type": "text",
      "x": 309.0012507922545,
      "y": 705.4524071104127,
      "width": 956.9961201278534,
      "height": 315.3287482160494,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b43",
      "roundness": null,
      "seed": 1268840232,
      "version": 259,
      "versionNonce": 294019855,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785793456608,
      "link": null,
      "locked": false,
      "text": "Las máquinas de estados suelen implementarse\ncon muchas sentencias condicionales ( if o\nswitch) que seleccionan el comportamiento\napropiado según el estado actual del objeto.\nNormalmente, este \"State\" es simplemente un\nconjunto de valores de los campos del objeto.",
      "fontSize": 42.04383309547326,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Las máquinas de estados suelen implementarse con muchas sentencias condicionales ( if o switch) que seleccionan el comportamiento apropiado según el estado actual del objeto. Normalmente, este \"State\" es simplemente un conjunto de valores de los campos del objeto.",
      "autoResize": false,
      "lineHeight": 1.25
    },
