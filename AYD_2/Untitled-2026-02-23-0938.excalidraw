    {
      "id": "sReHU1PFXl7L0Ma2swCK2",
      "type": "text",
      "x": 649.4579893309713,
      "y": 1413.6025713876493,
      "width": 666.388402363597,
      "height": 84.61865738783564,
      "angle": 0,
