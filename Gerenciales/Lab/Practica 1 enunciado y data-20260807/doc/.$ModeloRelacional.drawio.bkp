        <mxCell id="e31" value="FK_Actividad_Lenguajes  (idLenguaje)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=11;startFill=0;endFill=0;strokeWidth=2;strokeColor=#1F4E79;startArrow=ERmandOne;endArrow=ERzeroToMany;exitPerimeter=0;entryPerimeter=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=16;exitDy=0;entryX=0;entryY=0.5;entryDx=-16;entryDy=0;" parent="1" edge="1" source="t1" target="t21">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="e32" value="FK_Actividad_Periodos  (idPeriodo)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=11;startFill=0;endFill=0;strokeWidth=2;strokeColor=#1F4E79;startArrow=ERmandOne;endArrow=ERzeroToMany;exitPerimeter=0;entryPerimeter=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=-16;exitDy=0;entryX=1;entryY=0.5;entryDx=16;entryDy=0;" parent="1" edge="1" source="t8" target="t21">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="x33" value="Modelo relacional &amp;#8212; MayaCode_DB" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1F4E79;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="30" width="700" height="34"/>
        </mxCell>
        <mxCell id="x34" value="Notaci&amp;#243;n Crow&amp;#39;s Foot &amp;#183; Las tres tablas en 3FN y BCNF" style="text;html=1;fontSize=12;fontColor=#595959;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="64" width="700" height="22"/>
        </mxCell>
        <mxCell id="x35" value="&lt;b&gt;Lectura de las relaciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Lenguajes ||&amp;#8212;&amp;#8212;o&amp;lt; Actividad_Lenguajes&lt;/b&gt;&lt;br&gt;&amp;#8594; Un lenguaje tiene &lt;b&gt;cero o muchos&lt;/b&gt; registros de actividad.&lt;br&gt;&amp;#8592; Cada registro pertenece a &lt;b&gt;exactamente un&lt;/b&gt; lenguaje.&lt;br&gt;&lt;br&gt;&lt;b&gt;Periodos ||&amp;#8212;&amp;#8212;o&amp;lt; Actividad_Lenguajes&lt;/b&gt;&lt;br&gt;&amp;#8594; Un per&amp;#237;odo tiene &lt;b&gt;cero o muchos&lt;/b&gt; registros de actividad.&lt;br&gt;&amp;#8592; Cada registro pertenece a &lt;b&gt;exactamente un&lt;/b&gt; per&amp;#237;odo.&lt;br&gt;&lt;br&gt;La pata de cuervo marca d&amp;#243;nde vive la clave for&amp;#225;nea." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="510" width="470" height="250"/>
        </mxCell>
        <mxCell id="x36" value="&lt;b&gt;Por qu&amp;#233; la clave primaria del hecho es compuesta&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Actividad_Lenguajes&lt;/b&gt; resuelve la relaci&amp;#243;n &lt;b&gt;N:M&lt;/b&gt; entre Lenguajes y Periodos, y su medida es &lt;i&gt;cantidad&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Su clave primaria es &lt;b&gt;(idLenguaje, idPeriodo)&lt;/b&gt; y no una clave sustituta, porque la identidad del hecho &lt;b&gt;es&lt;/b&gt; la combinaci&amp;#243;n de sus dos dimensiones: un lenguaje medido en un trimestre. Una columna &lt;i&gt;IDENTITY&lt;/i&gt; identificar&amp;#237;a la fila, no el hecho, y dejar&amp;#237;a que la misma medici&amp;#243;n entrara dos veces con valores distintos.&lt;br&gt;&lt;br&gt;Con el par declarado como clave, la dependencia funcional &lt;b&gt;{idLenguaje, idPeriodo} &amp;#8594; cantidad&lt;/b&gt; tiene por determinante una superclave, y la tabla queda en &lt;b&gt;3FN&lt;/b&gt; y en &lt;b&gt;BCNF&lt;/b&gt;.&lt;br&gt;&lt;br&gt;En las dimensiones s&amp;#237; se usa clave sustituta, con la clave natural declarada como alternativa: &lt;i&gt;nombre&lt;/i&gt; en Lenguajes y &lt;i&gt;(anio, trimestre)&lt;/i&gt; en Periodos. Eso vuelve primos a esos atributos y por eso ninguna de las dos dimensiones puede violar la 3FN." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E2EFDA;strokeColor=#375623;fontSize=11;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="550" y="510" width="590" height="250"/>
        </mxCell>
        <mxCell id="x37" value="PK = clave primaria &amp;#183; UQ = clave alternativa (UNIQUE) &amp;#183; FK = clave for&amp;#225;nea &amp;#183; GENERATED = columna calculada por el motor" style="text;html=1;fontSize=10;fontColor=#595959;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="772" width="1100" height="20"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>